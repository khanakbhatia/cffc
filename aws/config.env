# Copy to aws/config.env and edit. Never commit aws/config.env if it ever contains anything
# sensitive (it shouldn't - it holds no secrets, only names/flags) - it's gitignored regardless.

AWS_PROFILE=cffc-research          # must already be configured via `aws configure --profile ...`
AWS_REGION=us-east-1               # Stage 2 scope: single region is fine; trail is multi-region regardless
BUCKET_SUFFIX=669760
                                    # bucket names must be globally unique; scripts refuse to run with this empty

TRAIL_NAME=cff-research-trail
PRESERVATION_BUCKET=cff-research-preservation-${BUCKET_SUFFIX}
SCENARIO_B_BUCKET=cff-research-scenario-b-${BUCKET_SUFFIX}

PROJECT_TAG=cffc-research           # every created resource is tagged Project=$PROJECT_TAG for safe cleanup

# Cost acknowledgment gate (docs/COST_NOTES.md). Nothing billable runs until this is "yes".
CFFC_ACK_COSTS=no

# Set by 00_preflight_checks.sh on success; scenario/setup scripts refuse to run without it.
CFFC_PREFLIGHT_OK=no
